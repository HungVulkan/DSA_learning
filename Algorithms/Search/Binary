#include <stdio.h>
#define N 8
void xuatmang(int *pa, int len)
{
    for (int i = 0; i < len; i++)
        printf("%d ", *(pa + i));
    printf("\n");
}
void nhapmang(int *pa, int len)
{
    for (int i = 0; i < len; i++){
        printf("Nhap a[%d]:", i);
        scanf("%d", (pa + i));
    }
}
int binarySearch(int *pa, int len, int key)
{
    int low = 0, high = len - 1, buoc = 0;
    while (low <= high){
        int mid = (low + high) / 2;
        buoc++;
        printf("Buoc %d: low=%d mid=%d high=%d → a[%d]=%d",
               buoc, low, mid, high, mid, pa[mid]);
        if (pa[mid] == key){
            printf(" → Tim thay!\n");
            return mid;
        } else if (pa[mid] < key){
            printf(" → Tim nua phai\n");
            low = mid + 1;
        } else {
            printf(" → Tim nua trai\n");
            high = mid - 1;
        }
    }
    return -1;
}
void insertionSort(int *pa, int len)
{
    for (int i = 1; i < len; i++){
        int x = pa[i], pos = i - 1;
        while (pos >= 0 && pa[pos] > x){
            pa[pos+1] = pa[pos]; pos--;
        }
        pa[pos+1] = x;
    }
}
int main()
{
    int a[N];
    int key, result;
    nhapmang(a, N);
    printf("Mang vua nhap:\n");
    xuatmang(a, N);
    insertionSort(a, N);
    printf("Mang sau khi sap xep (de tim nhi phan):\n");
    xuatmang(a, N);
    printf("Nhap gia tri can tim: ");
    scanf("%d", &key);
    result = binarySearch(a, N, key);
    if (result != -1)
        printf("Tim thay %d tai chi so a[%d]\n", key, result);
    else
        printf("Khong tim thay %d trong mang\n", key);
    return 0;
}
