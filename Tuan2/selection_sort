int binarysearch(int *pa, int len, int key)
{
    int left = 0, right = len -1, middle;
    do{
        middle = (left + right)/2;
        if(key == *(pa + middle)) return middle;
        else
            if(key < *(pa + middle)) right = middle-1;
            else left = middle+1;
    } while(left <= right);
    
    return -1;
}
