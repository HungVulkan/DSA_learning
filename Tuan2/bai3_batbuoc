#include <stdio.h>
#include <stdlib.h>
#define N 100

void nhapmang(int *pa, int *n) {
  printf("Nhap so phan tu cua mang: ");
  scanf("%d", n);
  for (int i = 0; i < *n; i++) {
    printf("nhap a[%d]: ", i);
    scanf("%d", (pa + i));
  }
}
void xuatmang(int *pa, int len) {
  for (int i = 0; i < len; i++)
    printf("%d ", *(pa + i));
  printf("\n");
}
void demSoDuongChay(int *pa, int n) {
  if (n == 0) {
    printf("So duong chay: 0\n");
    return;
  }
  int runs = 1;
  for (int i = 1; i < n; i++) {
    if (*(pa + i) < *(pa + i - 1)) {
      runs++;
    }
  }
  printf("So duong chay: %d\n", runs);
}

int main() {
  int a[N];
  int n = 0;
  nhapmang(a, &n);
  printf("Mang vua nhap: ");
  xuatmang(a, n);
  printf("\n--- Bai 3: Dem so duong chay ---\n");
  demSoDuongChay(a, n);
  return 0;
}
