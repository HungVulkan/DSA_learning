#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define MAX_SV 100

typedef struct {
    unsigned int ngay, thang, nam;
} NgaySinh;

typedef struct {
    NgaySinh ngaysinh;
    char mssv[11];
    char hoten[21];
    float dtb;
} SinhVien;

int docFileSinhVien(char *tenFile, SinhVien *ds_sv) {
    FILE *fi = fopen(tenFile, "rt");
    if (fi == NULL) {
        printf("Khong the mo file %s\n", tenFile);
        return 0;
    }
    int count = 0;
    while (fscanf(fi, "%u %u %u %10s %20s %f", 
                  &ds_sv[count].ngaysinh.ngay, 
                  &ds_sv[count].ngaysinh.thang, 
                  &ds_sv[count].ngaysinh.nam, 
                  ds_sv[count].mssv, 
                  ds_sv[count].hoten, 
                  &ds_sv[count].dtb) == 6) {
        count++;
        if (count >= MAX_SV) break;
    }
    fclose(fi);
    return count;
}

void xuatSinhVien(SinhVien sv) {
    printf("MSSV: %-10s | Ho ten: %-20s | Ngay sinh: %02u/%02u/%04u | DTB: %.2f\n",
           sv.mssv, sv.hoten, sv.ngaysinh.ngay, sv.ngaysinh.thang, sv.ngaysinh.nam, sv.dtb);
}

void xuatDanhSach(SinhVien *ds_sv, int n) {
    for (int i = 0; i < n; i++) {
        xuatSinhVien(ds_sv[i]);
    }
}
int soSanhNgaySinh(NgaySinh ns1, NgaySinh ns2) {
    if (ns1.nam < ns2.nam) return -1;
    if (ns1.nam > ns2.nam) return 1;
    if (ns1.thang < ns2.thang) return -1;
    if (ns1.thang > ns2.thang) return 1;
    if (ns1.ngay < ns2.ngay) return -1;
    if (ns1.ngay > ns2.ngay) return 1;
    return 0;
}

void timSVNgaySinhNhoNhat(SinhVien *ds_sv, int n) {
    if (n == 0) return;
    int idx_min = 0;
    for (int i = 1; i < n; i++) {
        if (soSanhNgaySinh(ds_sv[i].ngaysinh, ds_sv[idx_min].ngaysinh) < 0) {
            idx_min = i;
        }
    }
    printf("Sinh vien co ngay sinh nho nhat la:\n");
    xuatSinhVien(ds_sv[idx_min]);
}

void timSVDiemTrungBinh(SinhVien *ds_sv, int n) {
    float diem_yc;
    printf("Nhap diem trung binh can tim: ");
    scanf("%f", &diem_yc);
    
    int found = 0;
    printf("Danh sach sinh vien co diem trung binh %.2f:\n", diem_yc);
    for (int i = 0; i < n; i++) {
        if (ds_sv[i].dtb == diem_yc) {
            xuatSinhVien(ds_sv[i]);
            found++;
        }
    }
    if (found == 0) printf("Khong tim thay sinh vien nao co DTB = %.2f\n", diem_yc);
}

void sapXepTheoMSSV(SinhVien *ds_sv, int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (strcmp(ds_sv[i].mssv, ds_sv[j].mssv) > 0) {
                SinhVien temp = ds_sv[i];
                ds_sv[i] = ds_sv[j];
                ds_sv[j] = temp;
            }
        }
    }
}

void timSVMSSVNhiPhan(SinhVien *ds_sv, int n) {
    char mssv_yc[11];
    printf("Nhap MSSV can tim: ");
    scanf("%10s", mssv_yc);
    sapXepTheoMSSV(ds_sv, n);
    int left = 0, right = n - 1;
    int found_idx = -1;
    while (left <= right) {
        int mid = left + (right - left) / 2;
        int cmp = strcmp(ds_sv[mid].mssv, mssv_yc);
        if (cmp == 0) {
            found_idx = mid;
            break;
        } else if (cmp < 0) {
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }
    if (found_idx != -1) {
        printf("Tim thay sinh vien:\n");
        xuatSinhVien(ds_sv[found_idx]);
    } else {
        printf("Khong tim thay sinh vien co MSSV %s\n", mssv_yc);
    }
}

int main() {
    SinhVien ds_sv[MAX_SV];
    int n = docFileSinhVien("input_sv.txt", ds_sv);  
    if (n == 0) {
        printf("Khong co du lieu sinh vien hoac file khong ton tai. Vui long tao file input_sv.txt\n");
        return 1;
    }
    printf("=== DANH SACH SINH VIEN DOC TU FILE ===\n");
    xuatDanhSach(ds_sv, n);
    printf("\n--- Yeu cau 2: Sinh vien co ngay sinh nho nhat ---\n");
    timSVNgaySinhNhoNhat(ds_sv, n);
    printf("\n--- Yeu cau 3: Tim sinh vien theo DTB ---\n");
    timSVDiemTrungBinh(ds_sv, n);
    printf("\n--- Yeu cau 4: Tim sinh vien theo MSSV (Binary Search) ---\n");
    timSVMSSVNhiPhan(ds_sv, n);
    return 0;
}
