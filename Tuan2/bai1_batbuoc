#include <math.h>
#include <stdio.h>
#include <stdlib.h
#define N 100
void nhapmang(int *pa, int *n) {
  printf("Nhap so phan tu cua mang: ");
  scanf("%d", n);
  for (int i = 0; i < *n; i++) {
    printf("nhap a[%d]: ", i);
    scanf("%d", (pa + i));
  }
}

void xuatmang(int *pa, int len) {
  for (int i = 0; i < len; i++)
    printf("%d ", *(pa + i));
  printf("\n");
}

int isPrime(int n) {
  if (n < 2)
    return 0;
  for (int i = 2; i <= sqrt(n); i++) {
    if (n % i == 0)
      return 0;
  }
  return 1;
}

void timSoNguyenTo(int *pa, int n) {
  printf("Cac so nguyen to trong mang: ");
  int count = 0;
  for (int i = 0; i < n; i++) {
    if (isPrime(*(pa + i))) {
      printf("%d ", *(pa + i));
      count++;
    }
  }
  if (count == 0)
    printf("Khong co so nguyen to nao.");
  printf("\n");
}

int main() {
  int a[N];
  int n = 0;
  nhapmang(a, &n);
  printf("Mang vua nhap: ");
  xuatmang(a, n);
  timSoNguyenTo(a, n);
  return 0;
}
